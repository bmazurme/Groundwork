PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://groundwork:groundwork@localhost:5432/groundwork

REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO locally; drop S3_ENDPOINT/S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY and
# rely on the AWS SDK's default credential chain (IAM role) against real S3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=groundwork-documents
S3_ACCESS_KEY_ID=groundwork
S3_SECRET_ACCESS_KEY=groundwork-secret
S3_FORCE_PATH_STYLE=true

# onnx (default, in-process, no external service) or ollama.
EMBEDDINGS_PROVIDER=onnx
# Optional: where the ONNX provider caches the downloaded model.
TRANSFORMERS_CACHE_DIR=
# Only used when EMBEDDINGS_PROVIDER=ollama.
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
